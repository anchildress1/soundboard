# Copy to .env for local development. Real values live in Secret Manager or Cloud Run env vars.
# deploy.sh copies the secrets (OAuth client secret, session, YouTube key, Gemini key) into Secret Manager.

GCP_PROJECT_ID=
GCS_BUCKET=

# Gemini API authorization key from a paid-tier project, restricted to the Generative Language API.
# One key for dev and prod. Model names default to gemini-3.8-flash (analyst) and gemini-4-argon (picks).
GEMINI_API_KEY=
GEMINI_ANALYST_MODEL=
GEMINI_PICK_MODEL=

# Read-only YouTube Data API key from a second GCP project (search + catalog reads).
YOUTUBE_API_KEY=

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# 32+ random bytes, e.g. `openssl rand -base64 48`. Signs the session cookie.
SESSION_SECRET=

# Who may sign in: `invite` (default; invited emails only) or `open` (any Google account).
SIGNUP_MODE=invite
# Cloud KMS key that encrypts YouTube refresh tokens:
# projects/<project>/locations/us-central1/keyRings/soundboard/cryptoKeys/refresh-tokens
KMS_KEY=

# Neon Postgres, local dev only: use a dev branch, never main. Production's URLs live only in
# Secret Manager. Pooled for app traffic; direct (unpooled) for `drizzle-kit migrate` only.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Research runs: leave all three unset in dev, where deliveries run in the app process. deploy.sh
# sets them for the service. PEER_HEARING=1 lets Gemini hear a peer's public upload.
RESEARCH_QUEUE=
RESEARCH_TASK_URL=
RESEARCH_TASK_SA=
PEER_HEARING=

PUBLIC_SENTRY_DSN=
