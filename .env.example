# Copy to .env for local development. Real values live in Secret Manager or Cloud Run env vars.

GCP_PROJECT_ID=
GCS_BUCKET=

# llama-server base URL. The deployed sidecar listens on 127.0.0.1:8081.
MODEL_URL=http://127.0.0.1:8081
# Model sidecar image; required by deploy.sh. Push it to the same repository as package `model`
# (us-central1-docker.pkg.dev/<project>/soundboard/model:<tag>) so the cleanup policy keeps 2.
MODEL_IMAGE=

# Read-only YouTube Data API key from a second GCP project (search + catalog reads).
YOUTUBE_API_KEY=
FLR_CHANNEL_ID=

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
ALLOWLIST_EMAILS=
SESSION_SECRET=

PUBLIC_SENTRY_DSN=
