# Copy to .env for local development. Real values live in Secret Manager or Cloud Run env vars.

GCP_PROJECT_ID=
GCS_BUCKET=

# Local llama-server base URL. deploy.sh sets the Vertex endpoint's invoke URL for the service.
MODEL_URL=http://127.0.0.1:8081

# Read-only YouTube Data API key from a second GCP project (search + catalog reads).
YOUTUBE_API_KEY=
FLR_CHANNEL_ID=

GOOGLE_OAUTH_CLIENT_ID=
# deploy.sh copies the three secrets below into Secret Manager; the service reads them from there.
GOOGLE_OAUTH_CLIENT_SECRET=
# Comma-separated Google accounts allowed to sign in (Nathan, Ashley).
ALLOWLIST_EMAILS=
# Comma-separated demo accounts: run like Nathan against the sandbox channel, never write his memory.
DEMO_EMAILS=
# 32+ random bytes, e.g. `openssl rand -base64 48`. Signs the session cookie and salts IP hashes.
SESSION_SECRET=

PUBLIC_SENTRY_DSN=
