# Copy to .env for local development. Real values live in Secret Manager or Cloud Run env vars.

GCP_PROJECT_ID=
GCS_BUCKET=
GCP_REGION=us-central1

# llama-server base URL. The deployed sidecar listens on 127.0.0.1:8081.
MODEL_URL=http://127.0.0.1:8081
# Model sidecar image (built from the model story); required by deploy.sh.
MODEL_IMAGE=

# Read-only YouTube Data API key from a second GCP project (search + catalog reads).
YOUTUBE_API_KEY=
FLR_CHANNEL_ID=

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
ALLOWLIST_EMAILS=
SESSION_SECRET=

PUBLIC_SENTRY_DSN=
