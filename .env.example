# Copy to .env for local development. Real values live in Secret Manager or Cloud Run env vars.

GCP_PROJECT_ID=
GCS_BUCKET=

# Local llama-server base URL. deploy.sh sets the Vertex endpoint's invoke URL for the service.
MODEL_URL=http://127.0.0.1:8081

# Read-only YouTube Data API key from a second GCP project (search + catalog reads).
YOUTUBE_API_KEY=
FLR_CHANNEL_ID=

GOOGLE_OAUTH_CLIENT_ID=
# deploy.sh copies the three secrets below into Secret Manager; the service reads them from there.
GOOGLE_OAUTH_CLIENT_SECRET=
# 32+ random bytes, e.g. `openssl rand -base64 48`. Signs the session cookie.
SESSION_SECRET=

# Who may sign in: `invite` (default; invited emails only) or `open` (any Google account).
SIGNUP_MODE=invite
# Cloud KMS key that encrypts YouTube refresh tokens:
# projects/<project>/locations/us-central1/keyRings/soundboard/cryptoKeys/refresh-tokens
KMS_KEY=

# Neon Postgres. Pooled for app traffic; direct (unpooled) for `drizzle-kit migrate` only.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

PUBLIC_SENTRY_DSN=
