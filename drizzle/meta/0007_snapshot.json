        "artist_guides_approved_check": {
          "name": "artist_guides_approved_check",
          "value": "(\"artist_guides\".\"status\" = 'approved') = (\"artist_guides\".\"approved_at\" is not null) and (\"artist_guides\".\"status\" = 'proposed' or \"artist_guides\".\"grant_at\" is null)"
        },
        "artist_guides_sources_check": {
          "name": "artist_guides_sources_check",
          "value": "jsonb_typeof(\"artist_guides\".\"sources\") is not distinct from 'object' and case \"artist_guides\".\"status\"\n          when 'proposed' then \"artist_guides\".\"sources\" - array['uploads','drafts','edits','approvals','thin'] = '{}'::jsonb\n            and jsonb_typeof(\"artist_guides\".\"sources\"->'uploads') is not distinct from 'array' and jsonb_typeof(\"artist_guides\".\"sources\"->'drafts') is not distinct from 'array'\n            and jsonb_typeof(\"artist_guides\".\"sources\"->'edits') is not distinct from 'number' and jsonb_typeof(\"artist_guides\".\"sources\"->'approvals') is not distinct from 'number' and jsonb_typeof(\"artist_guides\".\"sources\"->'thin') is not distinct from 'boolean'\n          else \"artist_guides\".\"sources\" - array['uploads','drafts','edits','approvals','carriedOver'] = '{}'::jsonb\n            and jsonb_typeof(\"artist_guides\".\"sources\"->'uploads') is not distinct from 'number' and jsonb_typeof(\"artist_guides\".\"sources\"->'drafts') is not distinct from 'number'\n            and jsonb_typeof(\"artist_guides\".\"sources\"->'edits') is not distinct from 'number' and jsonb_typeof(\"artist_guides\".\"sources\"->'approvals') is not distinct from 'number' and jsonb_typeof(\"artist_guides\".\"sources\"->'carriedOver') is not distinct from 'boolean'\n          end"
