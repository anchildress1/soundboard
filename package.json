{
  "name": "soundboard",
  "version": "1.0.0",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "packageManager": "pnpm@12.9.1",
  "volta": {
    "node": "24.22.1",
    "pnpm": "12.9.1"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env node_modules/vite/bin/vite.js dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "eslint . --max-warnings 0 && stylelint \"src/**/*.{css,svelte}\" --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@electric-sql/pglite": "0.5.11",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.1",
    "@sveltejs/adapter-node": "^6.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/load-config": "^0.2.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^24.19.2",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "^5.0.5",
    "commitlint-plugin-rai": "^1.0.3",
    "drizzle-kit": "0.31.11",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "lefthook": "^2.2.2",
    "postcss-html": "^2.0.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "stylelint": "^17.16.0",
    "stylelint-value-no-unknown-custom-properties": "^6.1.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@ai-sdk/google": "4.0.105",
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/onest": "5.3.1",
    "@google-cloud/kms": "6.3.0",
    "@google-cloud/storage": "8.4.0",
    "@sentry/sveltekit": "11.9.0",
    "ai": "7.0.153",
    "drizzle-orm": "0.45.4",
    "google-auth-library": "11.3.1",
    "p-retry": "8.0.1",
    "pg": "8.23.1"
  },
  "imports": {
    "#lib/*.js": "./src/lib/*.ts",
    "#lib/*": "./src/lib/*",
    "#src/*": "./src/*"
  }
}
